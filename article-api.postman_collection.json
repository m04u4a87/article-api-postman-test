    {
      "name": "TC05 [正向] 依 userId 篩選文章",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"狀態碼是 200\", function () { pm.response.to.have.status(200); });\r\npm.test(\"共 10 筆\", function () { const data = pm.response.json(); pm.expect(data).to.have.lengthOf(10); });\r\npm.test(\"每筆 userId 都是 1\", function () { const data = pm.response.json(); data.forEach(function (item) { pm.expect(item.userId).to.eql(1); }); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/posts?userId=1",
          "host": [
