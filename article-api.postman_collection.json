      "name": "TC03 [正向] 新增文章",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"狀態碼是 201\", function () { pm.response.to.have.status(201); });\r\npm.test(\"回傳的 title 與送出的一致\", function () { const data = pm.response.json(); pm.expect(data.title).to.eql(\"QA測試文章\"); });\r\npm.test(\"有產生新的 id\", function () { const data = pm.response.json(); pm.expect(data).to.have.property(\"id\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"title\": \"QA測試文章\",\r\n  \"body\": \"測試內容\",\r\n  \"userId\": 1\r\n}",
          "options": {
            "raw": {
